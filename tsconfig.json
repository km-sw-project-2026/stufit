{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "outDir": "./dist",

    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "functions/**/*.ts",
    "worker/**/*.js",
    "types/**/*.d.ts"
  ]
}
